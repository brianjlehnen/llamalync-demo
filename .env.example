# ─── Build Integrations app credentials ─────────────────────────────────────
# A "Build Integrations"-typed app in https://app.vanta.com/developer.
# Used to PUT custom resources (user_account, computer, vulnerability) into
# Vanta and to upload evidence-document files to predefined slots.
# Scopes (enable all four when creating the app — Build Integrations scopes
# are app-creation-time in Developer Console):
#   connectors.self:read-resource, connectors.self:write-resource
#   self:write-document, self:read-document
VANTA_BUILD_CLIENT_ID=your-build-client-id-here
VANTA_BUILD_CLIENT_SECRET=your-build-client-secret-here
VANTA_INTEGRATION_ID=your-integration-id-here

# Resource IDs declared in Developer Console → your Build Integrations app →
# Resources tab. Each one is the internal id Vanta assigns to a resource
# definition (e.g. a "user_account"-typed personnel feed). Used in the body
# of PUT /v1/resources/<kind>.
VANTA_PERSONNEL_RESOURCE_ID=your-personnel-resource-id-here

# Computer resource IDs for the CMDB-X → Vanta devices sync. Each one is a
# Resource declared in the Build Integrations app for a specific base type.
# The path segment used in PUT /v1/resources/{type} is the EXACT name of the
# base type as listed in the Console dropdown (CamelCase, not snake_case).
# Two separate resources are required.
#
# Linux has no native base resource type in Vanta; CMDB-X Linux source rows
# are surfaced as "unsupported source row" in the dashboard and excluded
# from any PUT. No env var needed for Linux.
#
# See docs/scenarios/devices.md for setup.
VANTA_MACOS_RESOURCE_ID=your-macos-user-computer-resource-id-here
VANTA_WINDOWS_RESOURCE_ID=your-windows-user-computer-resource-id-here

# ─── Manage Vanta app credentials ───────────────────────────────────────────
# A separate "Manage Vanta"-typed app — Build Integrations and Manage Vanta
# cannot share an app, one app per surface. Reads /v1/people, /v1/tests,
# /v1/controls, /v1/vulnerabilities for the dashboard; writes /v1/risk-scenarios
# for the Risk scenario.
# Scopes: vanta-api.all:read, vanta-api.all:write.
VANTA_MANAGE_CLIENT_ID=your-manage-client-id-here
VANTA_MANAGE_CLIENT_SECRET=your-manage-client-secret-here

# REQUIRED for the Risk scenario. Vanta returns 422 "Invalid fields (riskRegister)"
# on POST/PATCH /v1/risk-scenarios when omitted, even in single-register tenants.
# Set to your register's name as shown in the Vanta UI → Risk Management.
# "Default" is the typical value.
VANTA_RISK_REGISTER=Default

# ─── Webhook signing secret ──────────────────────────────────────────────────
# Set this in the Vanta webhook configuration; the same value goes here.
# Used to verify HMAC-SHA256 signatures on incoming webhooks.
VANTA_WEBHOOK_SECRET=replace-with-webhook-secret

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Tenant context (visible on the dashboard header) ────────────────────────
# Drives the colored tenant ribbon at the top of the dashboard so an operator
# can confirm at a glance which Vanta tenant the app is pointed at. Useful
# for forked deployments where a misconfigured .env could otherwise point a
# dev instance at the wrong tenant silently.
#
#   VANTA_TENANT_NAME  Subdomain or human-readable name shown in the ribbon
#                      (e.g. "acme-corp" or "yourco-sandbox"). Pull from the
#                      URL when you log into your tenant at app.vanta.com.
#                      Unset → ribbon shows "tenant unconfigured" warning.
#
#   VANTA_ENV          Classification used to color the ribbon:
#                        sandbox     → green/neutral (default for dev tenants)
#                        production  → red warning (real customer tenant)
#                      Anything else → yellow "unverified" tint.
VANTA_TENANT_NAME=
VANTA_ENV=sandbox

# ─── Dashboard auth (signed-cookie session) ─────────────────────────────────
# Gates the dashboard when LLAMALYNC_PASSWORD is set. Signs session cookies
# with LLAMALYNC_SESSION_SECRET (any high-entropy value — generate with
# `openssl rand -hex 32`). /health and /webhooks/* stay open. Leave
# LLAMALYNC_PASSWORD blank to disable auth in local dev. In production both
# LLAMALYNC_PASSWORD and LLAMALYNC_SESSION_SECRET are required — the server
# refuses to start otherwise.
LLAMALYNC_USER=llamalync
LLAMALYNC_PASSWORD=
LLAMALYNC_SESSION_SECRET=replace-with-a-long-random-string

# ─── Logging ─────────────────────────────────────────────────────────────────
# LOG_LEVEL: debug | info | warn | error
# LOG_FORMAT: text | json   (json is friendlier for cloud log aggregators)
LOG_LEVEL=info
LOG_FORMAT=text

# ─── Cron schedules (optional overrides) ─────────────────────────────────────
# Defaults: personnel hourly. Device/vulnerability syncs are scaffolded but
# disabled until their Vanta resource schemas are verified.
# Scheduled syncs run automatically in production. In local/dev environments,
# set ENABLE_SCHEDULER=true only when you intentionally want cron writes.
ENABLE_SCHEDULER=false
# CRON_PERSONNEL=0 * * * *
# ENABLE_DEVICE_SYNC=false
# ENABLE_VULN_SYNC=false
